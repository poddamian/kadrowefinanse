---
import Layout from '../../layouts/Layout.astro';
import { ROK } from '../../lib/params2026';

const artykuly = [
  {
    url: '/blog/b2b-czy-umowa-o-prace-2026/',
    tytul: 'B2B czy umowa o pracę — co się bardziej opłaca w 2026 roku?',
    opis:
      'Porównanie netto z etatu i z B2B przy 4 poziomach zarobków, liczone tym samym silnikiem co kalkulator. Od jakiej kwoty B2B zaczyna się opłacać.',
    brew: 'case study · 4 poziomy zarobków',
  },
  {
    url: '/blog/skladka-zdrowotna-2026-przewodnik/',
    tytul: 'Składka zdrowotna przedsiębiorcy 2026 — pełny przewodnik po zmianach',
    opis:
      'Ile wynosi składka zdrowotna na skali, liniowym i ryczałcie w 2026 r. — stawki, minimalna składka, limity odliczeń i przykład liczbowy.',
    brew: 'przewodnik · skala, liniowy, ryczałt',
  },
  {
    url: '/blog/nadplata-kredytu-hipotecznego-okres-czy-rata/',
    tytul: 'Nadpłata kredytu hipotecznego — skrócić okres czy zmniejszyć ratę?',
    opis:
      'Porównanie dwóch trybów nadpłaty na przykładzie 400 000 zł: ile realnie oszczędzasz przy skróceniu okresu, a ile przy zmniejszeniu raty.',
    brew: 'case study · 400 000 zł, 25 lat',
  },
  {
    url: '/blog/ekwiwalent-za-urlop-jak-liczyc/',
    tytul: 'Ekwiwalent za niewykorzystany urlop — jak liczyć i kiedy się należy',
    opis:
      'Wzór na ekwiwalent krok po kroku, przykłady liczbowe dla różnej liczby dni i wymiaru etatu oraz zasady wypłaty przy rozwiązaniu umowy.',
    brew: 'poradnik · wzór krok po kroku',
  },
  {
    url: '/blog/ryczalt-czy-liniowy-2026/',
    tytul: 'Ryczałt czy podatek liniowy na B2B — co wybrać w 2026 roku?',
    opis:
      'Porównanie na przykładach przy 8, 12 i 20 tys. zł przychodu. Kiedy ryczałt się opłaca, a kiedy lepszy jest liniowy.',
    brew: 'case study · 3 poziomy przychodu',
  },
  {
    url: '/blog/jak-obnizyc-skladke-zdrowotna/',
    tytul: 'Jak obniżyć składkę zdrowotną na działalności gospodarczej',
    opis:
      'Legalne sposoby: wpływ kosztów firmowych, wybór formy opodatkowania, odliczenia — z przykładami liczbowymi.',
    brew: 'poradnik · legalne sposoby',
  },
  {
    url: '/blog/rekomendacja-s-wczesniejsza-splata-kredytu/',
    tytul: 'Rekomendacja S i wcześniejsza spłata kredytu — co musisz wiedzieć',
    opis:
      'Kiedy bank może pobrać rekompensatę za wcześniejszą spłatę, ile może wynosić i czy nadpłata mimo to się opłaca.',
    brew: 'case study · rekompensata vs oszczędność',
  },
  {
    url: '/blog/urlop-proporcjonalny-na-zadanie-zalegly/',
    tytul: 'Urlop na żądanie, zaległy, proporcjonalny — kompendium',
    opis:
      'Ile dni urlopu na żądanie, do kiedy wykorzystać zaległy i jak liczy się urlop proporcjonalny przy zmianie pracy w trakcie roku.',
    brew: 'kompendium · 3 rodzaje urlopu',
  },
  {
    url: '/blog/preferencyjny-zus-ulga-na-start/',
    tytul: 'Preferencyjny ZUS i ulga na start — ile trwają i co dalej?',
    opis:
      'Ulga na start, preferencyjny ZUS, duży ZUS — ile trwa każdy etap i o ile spada netto przy przejściu na kolejny, na przykładzie liczbowym.',
    brew: 'case study · 3 etapy oskładkowania',
  },
  {
    url: '/blog/maly-zus-plus-2026/',
    tytul: 'Mały ZUS Plus 2026 — kto może skorzystać i ile zaoszczędzi',
    opis:
      'Warunki ulgi, nowe zasady 36 miesięcy w każdym 60-miesięcznym okresie od 2026 r. i realne oszczędności na składkach przy 3 poziomach dochodu.',
    brew: 'case study · nowe zasady 2026',
  },
  {
    url: '/blog/wibor-czy-wiron-rata-kredytu/',
    tytul: 'WIBOR czy WIRON — jak zmiana wskaźnika wpływa na Twoją ratę kredytu',
    opis:
      'Czym różni się WIRON od WIBOR, kiedy nastąpi zamiana w umowach i ile realnie zmienia ratę różnica 0,4 pkt proc. — na przykładzie liczbowym.',
    brew: 'case study · kredyt 400 000 zł, 25 lat',
  },
  {
    url: '/blog/wypowiedzenie-umowy-a-ekwiwalent/',
    tytul: 'Wypowiedzenie umowy o pracę a wypłata ekwiwalentu — krok po kroku',
    opis:
      'Kiedy ekwiwalent za urlop się należy po wypowiedzeniu, jak urlop w okresie wypowiedzenia wpływa na kwotę i czym różni się to od odprawy.',
    brew: 'poradnik · krok po kroku',
  },
  {
    url: '/blog/umowa-zlecenie-a-umowa-o-prace/',
    tytul: 'Umowa zlecenie a umowa o pracę — różnice w składkach i podatkach',
    opis:
      'Ile na rękę z umowy zlecenia w porównaniu z umową o pracę przy tym samym brutto, jakie składki ZUS obowiązują i czy zlecenie liczy się do stażu pracy.',
    brew: 'case study · brutto 6 000 zł',
  },
  {
    url: '/blog/placa-minimalna-2026/',
    tytul: 'Płaca minimalna 2026 — brutto, netto i wpływ na inne świadczenia',
    opis:
      'Ile wynosi minimalne wynagrodzenie za pracę w 2026 r. netto na rękę i na jakie inne progi (preferencyjny ZUS, zasiłki, potrącenia) wpływa jego wysokość.',
    brew: 'poradnik · stawki 2026',
  },
  {
    url: '/blog/kwota-wolna-progi-pit-2026/',
    tytul: 'Kwota wolna od podatku i progi PIT 2026 — jak wpływają na wypłatę',
    opis:
      'Ile wynosi kwota wolna i drugi próg PIT w 2026 r., od jakiego dochodu obowiązuje stawka 32% i jak rośnie efektywne obciążenie przy trzech poziomach zarobków.',
    brew: 'case study · 3 poziomy zarobków',
  },
  {
    url: '/blog/pit-2-ulga-klasy-sredniej-2026/',
    tytul: 'PIT-2 i ulga dla klasy średniej — co się zmieniło w 2026',
    opis:
      'Jak PIT-2 wpływa na miesięczną wypłatę i dlaczego ulga dla klasy średniej nie obowiązuje już od połowy 2022 roku — z przykładem liczbowym.',
    brew: 'case study · brutto 6 000 zł',
  },
  {
    url: '/blog/zasilek-chorobowy-etat-b2b/',
    tytul: 'Zasiłek chorobowy 2026 — ile wynosi i kto go wypłaca (etat vs B2B)',
    opis:
      'Ile realnie dostaniesz na zwolnieniu lekarskim na etacie i na B2B — porównanie podstawy wymiaru, stawek 80/100% i okresu wyczekiwania, na przykładzie liczbowym.',
    brew: 'case study · etat vs duży ZUS vs pref. ZUS',
  },
  {
    url: '/blog/urlop-macierzynski-rodzicielski/',
    tytul: 'Urlop macierzyński i rodzicielski — ile pieniędzy zostaje na rękę',
    opis:
      'Porównanie dwóch wariantów zasiłku: 81,5% przez cały okres vs 100%/70% osobno. Na przykładzie 6 000 zł brutto.',
    brew: 'case study · 2 warianty rozliczenia',
  },
  {
    url: '/blog/l4-na-dzialalnosci-gospodarczej/',
    tytul: 'Zwolnienie L4 na działalności gospodarczej — jak liczy się zasiłek',
    opis:
      'Praktyczny przewodnik: 90-dniowy okres wyczekiwania, terminy opłacania składki chorobowej, co się dzieje przy zawieszeniu firmy.',
    brew: 'poradnik · formalności krok po kroku',
  },
  {
    url: '/blog/swiadczenie-rehabilitacyjne/',
    tytul: 'Świadczenie rehabilitacyjne — ile wynosi i jak długo można je pobierać',
    opis:
      'Co dzieje się po wyczerpaniu 182 dni zasiłku chorobowego: warunki przyznania, stawki 90/75/100%, maksymalny okres 12 miesięcy.',
    brew: 'poradnik · po 182 dniach L4',
  },
  {
    url: '/blog/ppk-ile-kosztuje/',
    tytul: 'PPK 2026 — ile realnie kosztuje pracownika i pracodawcę',
    opis:
      'Ile miesięcznie potrąca się z Twojej pensji na PPK, ile dokłada pracodawca i ile dopłaca państwo — pełne rozbicie na przykładzie 6 000 zł brutto.',
    brew: 'case study · brutto 6 000 zł',
  },
  {
    url: '/blog/rezygnacja-z-ppk-kalkulacja/',
    tytul: 'Czy warto rezygnować z PPK — kalkulacja korzyści i strat',
    opis:
      'Ile realnie tracisz, rezygnując z PPK, a ile zyskujesz na wyższym wynagrodzeniu netto od razu. Porównanie na 10-letnim przykładzie.',
    brew: 'case study · bilans 10 lat',
  },
];
---

<Layout
  title={`Blog — poradniki finansowo-kadrowe ${ROK}`}
  description="Artykuły o podatkach, ZUS, składce zdrowotnej i kredytach — wyliczenia na przykładach, oparte na tych samych wzorach co nasze kalkulatory."
>
  <h1>Blog</h1>
  <p style="max-width: 640px; color: var(--atrament-2);">
    Poradniki i wyliczenia na przykładach — o podatkach, ZUS, składce zdrowotnej i kredytach.
    Każdy artykuł opiera się na tych samych wzorach co nasze kalkulatory.
  </p>

  <div class="siatka-kart">
    {
      artykuly.map((a) => (
        <a href={a.url} class="karta-narzedzia">
          <span class="brew">{a.brew}</span>
          <h3>{a.tytul}</h3>
          <p>{a.opis}</p>
        </a>
      ))
    }
  </div>
</Layout>
